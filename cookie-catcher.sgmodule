#!name=🍪 Cookie 抓取开关
#!desc=按需抓取: 哔哩哔哩 / 抖音 / 快手 / 斗鱼。打开模块 → 刷 App → 收到通知 → 关闭模块。Cookie 按域名保存, 去 BoxJs 查看复制。
#!system=ios

[Script]
# 全匹配, 由脚本内 TARGET_HOSTS 名单过滤域名 (只抓名单里的站)
cookie_catcher = type=http-request,pattern=^https?:\/\/,requires-body=0,max-size=0,script-path=https://raw.githubusercontent.com/erleizi/cookie-catcher/main/cookie-catcher.js,timeout=10

[MITM]
# 四家的主 API 域名; 想加新站就在这里追加它的 API 域名, 脚本端父域名自动覆盖子域名
hostname = %APPEND% api.bilibili.com, app.bilibili.com, aweme.snssdk.com, www.douyin.com, api.kuaishouzt.com, www.kuaishou.com, www.douyu.com, apiv2.douyu.com
